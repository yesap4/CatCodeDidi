# Copy this file to ".env" and fill in your key. ".env" is git-ignored.

# Required for AI answers. Get a free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_api_key_here

# Optional. Defaults to gemini-3.5-flash-lite (fast, low-latency).
# Other options: gemini-3.6-flash (higher quality), gemini-3.7-flash.
GEMINI_MODEL=gemini-3.5-flash-lite
